# ---- Core ----
# demo = synthetic data + mock integrations (default). live = real providers (still gated by admin switches).
APP_MODE=demo
APP_URL=http://localhost:3000
# Public domain for HTTPS (docker-compose.prod.yml). Without one, deploy/install.sh uses <server-ip>.sslip.io
DOMAIN=
DATABASE_URL=postgresql://molly:molly-local-only@localhost:5432/molly
# Long random string (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
STORAGE_DIR=./storage
POSTGRES_PASSWORD=molly-local-only

# ---- Seed (first run) ----
# Demo mode defaults: admin@demo.local / demo-admin-pass, molly@demo.local / demo-recruiter-pass
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_RECRUITER_PASSWORD=
ORG_NAME=
# false = the AI does not text CDL links (no registered SMS number yet); recruiter collects the CDL
CDL_BY_SMS=true
# Shown on the public /privacy page (optional)
PRIVACY_CONTACT_EMAIL=

# ---- Webhook signing ----
# Signs the provider-neutral event endpoint (/api/webhooks/voice/mock)
WEBHOOK_SIGNING_SECRET=
# Signs lead intake from other systems (/api/webhooks/leads)
LEAD_WEBHOOK_SECRET=

# --- Google Sheets lead source (see docs/INTEGRATIONS.md) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=A:Z
GOOGLE_SHEETS_ID_COLUMN=
# Optional: header of a column the app may write progress into (needs Editor access)
GOOGLE_SHEETS_STATUS_COLUMN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key from the service account JSON key, with \n for line breaks
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---- Retell AI (voice agent: live AI calls) ----
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Telnyx AI Assistant (alternative to Retell). Set VOICE_PROVIDER=telnyx to use it.
# Create the assistant with: docker compose exec web npx tsx scripts/telnyx-setup.ts
VOICE_PROVIDER=retell
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_WEBHOOK_TOKEN=          # long random string, e.g. openssl rand -hex 24
TELNYX_ASSISTANT_ID=
TELNYX_TEXML_APP_ID=
TELNYX_ACCOUNT_SID=            # optional, for call-status reconciliation

# ---- RingCentral (SMS + human click-to-call) ----
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_SMS_FROM=
RINGCENTRAL_WEBHOOK_VERIFICATION_TOKEN=

# ---- HeyGen (private voice previews only; not usable for live calls) ----
HEYGEN_API_KEY=
