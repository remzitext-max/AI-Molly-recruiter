{
  "name": "molly-recruiter",
  "version": "0.1.0",
  "private": true,
  "description": "AI truck-driver recruiting assistant (Molly) with human handoff",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "worker": "tsx worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "exceljs": "4.4.0",
    "libphonenumber-js": "1.13.15",
    "luxon": "3.7.2",
    "next": "15.5.28",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/luxon": "3.7.6",
    "@types/node": "22.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
